FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen
COPY --chown=1001:1001 . .
RUN groupadd -g 1001 voiceagent && \
    useradd -u 1001 -g voiceagent -s /bin/sh voiceagent
ENV PYTHONDONTWRITEBYTECODE=1 UV_CACHE_DIR=/tmp/uv_cache
USER voiceagent
CMD ["uv", "run", "--no-sync", "uvicorn", "audio_processor.service:app", "--host", "0.0.0.0", "--port", "8094", "--workers", "1", "--limit-concurrency", "4", "--timeout-keep-alive", "5"]
