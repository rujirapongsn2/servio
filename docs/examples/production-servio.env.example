# NEW deployment template. Merge into an existing .env; never overwrite its secrets.
# Host A: Servio. Host B: embedding.internal.example (sample private IP 10.20.0.20).
OPENAI_API_KEY=REPLACE_WITH_LLM_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
JWT_SECRET_KEY=REPLACE_WITH_STABLE_RANDOM_SECRET
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_DB=voice_agents
# Native Python only; Docker Compose overrides DATABASE_URL for its postgres service.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/voice_agents
ALLOWED_ORIGINS=https://servio.example.com
NEXT_PUBLIC_API_URL=https://servio.example.com
NEXT_PUBLIC_WEBSOCKET_ENDPOINT=wss://servio.example.com/ws
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

LOCAL_KNOWLEDGE_HYBRID_ENABLED=true
EMBEDDING_BASE_URL=https://embedding.internal.example/v1
EMBEDDING_MODEL=ggml-org/embeddinggemma-2-GGUF:BF16
EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_GATEWAY_KEY
EMBEDDING_QUERY_PREFIX="task: search result | query: "
EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=60

LOCAL_KNOWLEDGE_IMAGES_ENABLED=true
MULTIMODAL_EMBEDDING_BASE_URL=https://embedding.internal.example/v1
MULTIMODAL_EMBEDDING_MODEL=ggml-org/embeddinggemma-2-GGUF:BF16
# This template uses ONE shared gateway key; repeat its value explicitly.
MULTIMODAL_EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_GATEWAY_KEY
MULTIMODAL_EMBEDDING_SPACE=embeddinggemma2-bf16-mmproj-shared8090-v1
MULTIMODAL_QUERY_PREFIX="task: search result | query: "
MULTIMODAL_EMBEDDING_TIMEOUT_SECONDS=180
IMAGE_OCR_MODEL_SOURCE=database
IMAGE_QA_MODEL_SOURCE=database
# Enable after selecting suitable Vision models in Settings > Providers.
LOCAL_KNOWLEDGE_IMAGE_OCR_ENABLED=false
LOCAL_KNOWLEDGE_IMAGE_QA_ENABLED=false

# Enable AFTER Audio Processor and the pinned audio revision are configured.
LOCAL_KNOWLEDGE_AUDIO_ENABLED=false
AUDIO_EMBEDDING_BASE_URL=https://embedding.internal.example/v1
AUDIO_EMBEDDING_MODEL=ggml-org/embeddinggemma-2-GGUF:BF16
AUDIO_EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_GATEWAY_KEY
AUDIO_EMBEDDING_REVISION=REPLACE_WITH_EXACT_WEIGHTS_AND_PROJECTOR_REVISION
AUDIO_QUERY_PREFIX="task: search result | query: "
AUDIO_EMBEDDING_TIMEOUT_SECONDS=180
# Sample Docker bridge address for Host A; see guide's extra_hosts setup.
AUDIO_PROCESSOR_BASE_URL=http://servio-host:8094
KNOWLEDGE_AUDIO_ASR_PROVIDER=local
KNOWLEDGE_AUDIO_WHISPER_CLI=/opt/whisper/bin/whisper-cli
KNOWLEDGE_AUDIO_WHISPER_MODEL=/srv/whisper/ggml-medium.bin
KNOWLEDGE_AUDIO_VAD_MODEL=/srv/whisper/ggml-silero-v6.2.0.bin
KNOWLEDGE_AUDIO_ASR_REVISION=REPLACE_WITH_EXACT_WHISPER_AND_VAD_REVISION
KNOWLEDGE_AUDIO_USE_GPU=false
KNOWLEDGE_AUDIO_ASR_TIMEOUT_SECONDS=1200
KNOWLEDGE_AUDIO_TIMEOUT_SECONDS=2220
KNOWLEDGE_AUDIO_MAX_SECONDS=600
KNOWLEDGE_AUDIO_SEGMENT_SECONDS=20
KNOWLEDGE_AUDIO_OVERLAP_SECONDS=2
# Optional ASR provider; leave local selected unless remote transcription is intended.
GROQ_API_KEY=
KNOWLEDGE_AUDIO_GROQ_MODEL=whisper-large-v3-turbo
GEMINI_DOCUMENT_SEARCH_CREATE_ENABLED=false
