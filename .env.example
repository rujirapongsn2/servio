# Copy to .env for a new deployment. Never replace an existing .env blindly.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Generate a stable secret with: openssl rand -hex 32
JWT_SECRET_KEY=
SOFTNIX_API_KEY=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=voice_agents
# Used by native Python. Docker Compose supplies its own database container URL.
DATABASE_URL=postgresql://postgres:change-this-password@127.0.0.1:5432/voice_agents
ALLOWED_ORIGINS=https://servio.example.com
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NEXT_PUBLIC_API_URL=https://servio.example.com
NEXT_PUBLIC_WEBSOCKET_ENDPOINT=wss://servio.example.com/ws

# Runtime defaults. Saved Agent/provider/tool model selections take precedence.
DEFAULT_AGENT_MODEL=gpt-4o-mini
DEFAULT_AGENT_MODELS=gpt-4o-mini,gpt-4o
# Leave blank to keep the team's fallback Agent model/provider for routing.
COORDINATOR_MODEL=
INTENT_MODEL=gpt-4o-mini
INTENT_BASE_URL=
INTENT_API_KEY=
ENRICHMENT_MODEL=gpt-4o-mini
ENRICHMENT_BASE_URL=
ENRICHMENT_API_KEY=
PROMPT_OPTIMIZE_MODEL=gpt-4o-mini
PROMPT_OPTIMIZE_BASE_URL=
PROMPT_OPTIMIZE_API_KEY=

# Voice provider overrides fall back to OPENAI_BASE_URL / OPENAI_API_KEY.
VOICE_STT_MODEL=gpt-4o-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=ash
VOICE_WELCOME_TTS_MODEL=tts-1
VOICE_WELCOME_TTS_VOICE=alloy
VOICE_BASE_URL=
VOICE_API_KEY=

# OCR/QA default to Settings > Providers. Environment mode requires all three
# corresponding values. Use not-required as API_KEY for a local unauthenticated API.
IMAGE_OCR_MODEL_SOURCE=database
IMAGE_OCR_MODEL=
IMAGE_OCR_BASE_URL=
IMAGE_OCR_API_KEY=
IMAGE_QA_MODEL_SOURCE=database
IMAGE_QA_MODEL=
IMAGE_QA_BASE_URL=
IMAGE_QA_API_KEY=
LOCAL_KNOWLEDGE_IMAGE_OCR_ENABLED=false
LOCAL_KNOWLEDGE_IMAGE_QA_ENABLED=false

# Text, image, and audio embeddings share the model served on port 8090.
# Optional API keys use Authorization: Bearer; blank keeps anonymous access.
# Keys are separate per service, with no fallback to OPENAI_API_KEY or each other.
# Image/audio /health and /props probes use their corresponding embedding key.
# Embedding services must return 768 dimensions. Replace host.docker.internal
# with 127.0.0.1 when running Python natively on the inference host.
LOCAL_KNOWLEDGE_HYBRID_ENABLED=false
EMBEDDING_BASE_URL=http://host.docker.internal:8090/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=ggml-org/embeddinggemma-2-GGUF:BF16
EMBEDDING_QUERY_PREFIX="task: search result | query: "
EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=8

LOCAL_KNOWLEDGE_IMAGES_ENABLED=false
MULTIMODAL_EMBEDDING_BASE_URL=http://host.docker.internal:8090/v1
MULTIMODAL_EMBEDDING_API_KEY=
MULTIMODAL_EMBEDDING_MODEL=ggml-org/embeddinggemma-2-GGUF:BF16
MULTIMODAL_EMBEDDING_SPACE=embeddinggemma2-bf16-mmproj-shared8090-v1
MULTIMODAL_QUERY_PREFIX="task: search result | query: "
MULTIMODAL_EMBEDDING_TIMEOUT_SECONDS=180
MULTIMODAL_IMAGE_QUERY_MIN_SCORE=0.82
MULTIMODAL_IMAGE_QUERY_MAX_SCORE_GAP=0.06
MULTIMODAL_IMAGE_QUERY_MAX_RESULTS=5
# Optional category verification uses the effective Image Q&A model above.
MULTIMODAL_IMAGE_RERANK_ENABLED=false
MULTIMODAL_IMAGE_RERANK_CANDIDATES=20
MULTIMODAL_IMAGE_RERANK_CANDIDATE_MIN_SCORE=0.2
MULTIMODAL_IMAGE_RERANK_MIN_CONFIDENCE=0.8
MULTIMODAL_IMAGE_RERANK_TIMEOUT_SECONDS=25

LOCAL_KNOWLEDGE_AUDIO_ENABLED=false
# Servio Audio Processor: speech-to-text and local audio normalization.
# Requires the Servio /health, /preview, /extract, /normalize API.
# For Linux Docker, the host processor must bind to an interface reachable from Docker.
# Export KNOWLEDGE_AUDIO_BIND before launching the shell script; see README.
AUDIO_PROCESSOR_BASE_URL=http://host.docker.internal:8094
AUDIO_EMBEDDING_BASE_URL=http://host.docker.internal:8090/v1
AUDIO_EMBEDDING_API_KEY=
AUDIO_EMBEDDING_MODEL=ggml-org/embeddinggemma-2-GGUF:BF16
# Pin the deployed weights and audio projector revision before enabling audio.
# Changing an embedding model ID requires rebuilding its existing vector index.
AUDIO_EMBEDDING_REVISION=
AUDIO_QUERY_PREFIX="task: search result | query: "
AUDIO_EMBEDDING_TIMEOUT_SECONDS=180
# The processor reads only KNOWLEDGE_AUDIO_* and GROQ_API_KEY from root .env.
# Exported/service environment values take precedence; restart the processor to apply changes.
# local (default) uses whisper.cpp; groq sends normalized audio to Groq.
KNOWLEDGE_AUDIO_ASR_PROVIDER=local
GROQ_API_KEY=
KNOWLEDGE_AUDIO_GROQ_MODEL=whisper-large-v3-turbo
# Optional; production endpoint is fixed. Loopback HTTP is allowed for isolated tests.
KNOWLEDGE_AUDIO_GROQ_BASE_URL=https://api.groq.com/openai/v1
# Local provider only. Retain these paths/revision to switch back to local.
KNOWLEDGE_AUDIO_WHISPER_CLI=
KNOWLEDGE_AUDIO_WHISPER_MODEL=
KNOWLEDGE_AUDIO_VAD_MODEL=
KNOWLEDGE_AUDIO_ASR_REVISION=
# Enable only with a GPU-capable whisper.cpp build (Metal on Apple Silicon).
KNOWLEDGE_AUDIO_USE_GPU=false
# Processor ASR wall-clock budget: 1..1800 seconds, for either provider.
KNOWLEDGE_AUDIO_ASR_TIMEOUT_SECONDS=1200
# Backend request budget: 2161..3600 seconds; lower legacy values are raised.
KNOWLEDGE_AUDIO_TIMEOUT_SECONDS=2220
# Applies to both providers. Supported maximum is 600 seconds per recording.
KNOWLEDGE_AUDIO_MAX_SECONDS=600
KNOWLEDGE_AUDIO_SEGMENT_SECONDS=20
KNOWLEDGE_AUDIO_OVERLAP_SECONDS=2

# Legacy Gemini Document Search only; Local Knowledge needs no Gemini key.
GEMINI_DOCUMENT_SEARCH_CREATE_ENABLED=false
# GEMINI_API_KEY=
# GEMINI_FILE_SEARCH_MODEL=gemini-2.5-flash
