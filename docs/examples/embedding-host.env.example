# Host B, read by systemd EnvironmentFile (not by Servio).
# Install the validated llama-server binary at /opt/llama/bin/llama-server.
EMBEDDING_MODEL_PATH=/srv/embedding/embeddinggemma-2-BF16.gguf
EMBEDDING_PROJECTOR_PATH=/srv/embedding/mmproj-embeddinggemma-2-BF16.gguf
EMBEDDING_ALIAS=ggml-org/embeddinggemma-2-GGUF:BF16
EMBEDDING_GPU_LAYERS=99
# Record the exact binary commit and model/projector SHA256 separately.
# API key is kept in /etc/servio-embedding/api-key, not in command arguments.
